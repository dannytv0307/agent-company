{
  "name": "agent-trace",
  "displayName": "Agent Trace",
  "description": "See what Claude Code is doing, live, against your setup: CLAUDE.md, agents, slash commands, skills, MCP servers, hooks and plugins, lit up as they are used.",
  "version": "0.2.0",
  "publisher": "dannytv0307",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/dannytv0307/agent-company.git"
  },
  "bugs": {
    "url": "https://github.com/dannytv0307/agent-company/issues"
  },
  "homepage": "https://github.com/dannytv0307/agent-company#readme",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0d0c0b",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "AI",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "agents",
    "subagents",
    "mcp",
    "visualization",
    "workflow"
  ],
  "main": "./out/extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "agentFlow.open",
        "title": "Open Flow",
        "category": "Agent Trace",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "agentFlow.follow",
        "title": "Follow the Latest Session",
        "category": "Agent Trace",
        "icon": "$(pin)"
      },
      {
        "command": "agentFlow.showSession",
        "title": "Show Session",
        "category": "Agent Trace"
      }
    ],
    "configuration": {
      "title": "Agent Trace",
      "properties": {
        "agentTrace.accentColor": {
          "type": "string",
          "default": "vscode",
          "enum": [
            "vscode",
            "gold",
            "claude",
            "ocean",
            "teal",
            "violet",
            "rose"
          ],
          "enumDescriptions": [
            "The accent of your VS Code theme",
            "Warm gold",
            "Claude’s terracotta",
            "Ocean blue",
            "Teal",
            "Violet",
            "Rose"
          ],
          "description": "The colour that marks work in progress in the flow."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentFlow",
          "title": "Agent Trace",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "agentFlow": [
        {
          "id": "agentFlow.sessions",
          "name": "Active Sessions"
        },
        {
          "id": "agentFlow.setup",
          "name": "Setup (.claude)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agentFlow.sessions",
        "contents": "No Claude Code session is at work in this folder right now.\nStart one here (extension or terminal) and it shows up while it runs. Earlier sessions are in the session list of the Flow tab.\n[Open Flow](command:agentFlow.open)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentFlow.open",
          "when": "view == agentFlow.sessions",
          "group": "navigation"
        },
        {
          "command": "agentFlow.follow",
          "when": "view == agentFlow.sessions",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "agentFlow.showSession",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "npm run build && npx --yes @vscode/vsce@3 package --no-dependencies --out agent-trace.vsix",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p src",
    "dev:web": "vite"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "1.100.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xyflow/react": "^12.12.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
