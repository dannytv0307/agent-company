{
  "name": "agent-trace",
  "displayName": "Agent Trace",
  "description": "Chat with your own Claude Code and Codex, one or both, and watch them work live: agents, subagents and tool calls drawn as a flow against the setup each loaded (the Claude factory and the Codex factory). Let them hand tasks to each other, and answer permissions right on the flow.",
  "version": "1.0.0",
  "publisher": "dannytv0307",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/dannytv0307/agent-company.git"
  },
  "bugs": {
    "url": "https://github.com/dannytv0307/agent-company/issues"
  },
  "homepage": "https://github.com/dannytv0307/agent-company#readme",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0d0c0b",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "AI",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "codex",
    "openai",
    "agents",
    "subagents",
    "chat",
    "mcp",
    "visualization",
    "workflow"
  ],
  "main": "./out/extension.cjs",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:agentFlow.flow"
  ],
  "contributes": {
    "commands": [
      {
        "command": "agentFlow.open",
        "title": "Open",
        "category": "Agent Trace",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "agentFlow.newChat",
        "title": "New Chat",
        "category": "Agent Trace",
        "icon": "$(add)"
      },
      {
        "command": "agentFlow.showSession",
        "title": "Open Session",
        "category": "Agent Trace"
      },
      {
        "command": "agentFlow.deleteSession",
        "title": "Delete Session",
        "category": "Agent Trace",
        "icon": "$(trash)"
      }
    ],
    "configuration": {
      "title": "Agent Trace",
      "properties": {
        "agentTrace.claudePath": {
          "type": "string",
          "default": "",
          "description": "Path to your Claude Code CLI (claude). Empty: found on PATH or in ~/.local/bin."
        },
        "agentTrace.codexPath": {
          "type": "string",
          "default": "",
          "description": "Path to your Codex CLI (codex). Empty: found on PATH."
        },
        "agentTrace.accentColor": {
          "type": "string",
          "default": "vscode",
          "enum": [
            "vscode",
            "gold",
            "claude",
            "ocean",
            "teal",
            "violet",
            "rose"
          ],
          "enumDescriptions": [
            "The accent of your VS Code theme",
            "Warm gold",
            "Claude’s terracotta",
            "Ocean blue",
            "Teal",
            "Violet",
            "Rose"
          ],
          "description": "The colour that marks work in progress in the flow."
        },
        "agentTrace.notifyWhenWaiting": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification when Claude Code is waiting for you: a permission to grant, a question to answer, a plan to approve."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentFlow",
          "title": "Agent Trace",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "agentFlow": [
        {
          "id": "agentFlow.sessions",
          "name": "Sessions"
        },
        {
          "id": "agentFlow.setup",
          "name": "Claude Factory"
        },
        {
          "id": "agentFlow.codexSetup",
          "name": "Codex Factory",
          "when": "agentTrace.hasCodex"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agentFlow.sessions",
        "contents": "No Claude Code session in this folder yet.\n[New Chat](command:agentFlow.newChat)\nAgent Trace runs your own Claude Code CLI, with your login and settings. Sessions started in a terminal or in Claude Code’s extension show here too."
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentFlow.newChat",
          "when": "view == agentFlow.sessions",
          "group": "navigation"
        },
        {
          "command": "agentFlow.open",
          "when": "view == agentFlow.sessions",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "agentFlow.showSession",
          "when": "false"
        },
        {
          "command": "agentFlow.deleteSession",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "agentFlow.deleteSession",
          "when": "view == agentFlow.sessions && viewItem == session",
          "group": "inline"
        },
        {
          "command": "agentFlow.deleteSession",
          "when": "view == agentFlow.sessions && viewItem == session",
          "group": "9_delete"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "npm run build && npx --yes @vscode/vsce@3 package --no-dependencies --out agent-trace.vsix",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p src",
    "dev:web": "vite"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.308",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "1.100.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xyflow/react": "^12.12.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "zod": "^4.6.7"
  }
}
