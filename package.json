{
  "name": "agent-flow",
  "displayName": "Agent Flow",
  "description": "See what Claude Code is doing, live, against your setup: CLAUDE.md, agents, slash commands, skills, MCP servers, hooks and plugins, lit up as they are used.",
  "version": "0.1.0",
  "publisher": "dannytv0307",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "repository": { "type": "git", "url": "https://github.com/dannytv0307/agent-company.git" },
  "icon": "media/icon.png",
  "engines": { "vscode": "^1.100.0" },
  "categories": ["AI", "Visualization", "Other"],
  "main": "./out/extension.cjs",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      { "command": "agentFlow.open", "title": "Open Flow", "category": "Agent Flow", "icon": "$(type-hierarchy)" },
      { "command": "agentFlow.follow", "title": "Follow the Latest Session", "category": "Agent Flow", "icon": "$(pin)" },
      { "command": "agentFlow.showSession", "title": "Show Session", "category": "Agent Flow" }
    ],
    "viewsContainers": {
      "activitybar": [{ "id": "agentFlow", "title": "Agent Flow", "icon": "media/activity.svg" }]
    },
    "views": {
      "agentFlow": [
        { "id": "agentFlow.sessions", "name": "Claude Code Sessions" },
        { "id": "agentFlow.setup", "name": "Setup (.claude)" }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agentFlow.sessions",
        "contents": "No Claude Code sessions in this folder yet.\nStart Claude Code here (extension or terminal) and its work shows up live.\n[Open Flow](command:agentFlow.open)"
      }
    ],
    "menus": {
      "view/title": [
        { "command": "agentFlow.open", "when": "view == agentFlow.sessions", "group": "navigation" },
        { "command": "agentFlow.follow", "when": "view == agentFlow.sessions", "group": "navigation" }
      ],
      "commandPalette": [{ "command": "agentFlow.showSession", "when": "false" }]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "npm run build && npx --yes @vscode/vsce@3 package --no-dependencies --skip-license --out agent-flow.vsix",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p src",
    "dev:web": "vite"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "1.100.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xyflow/react": "^12.12.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
